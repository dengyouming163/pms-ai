# ========== 数据库 ==========
DB_NAME=pms_ai
DB_USER=pms
DB_PASSWORD=pms_local_dev

# ========== 认证 ==========
JWT_SECRET=local-dev-jwt-secret-change-me
INTERNAL_SERVICE_TOKEN=local-dev-internal-token
MINI_JWT_SECRET=local-dev-mini-jwt-secret

# ========== Agent 服务 ==========
AGENT_API_URL=http://localhost:8000/api
# pms-agent → pms-server 内部工具端点 base URL（容器内 compose 会覆盖为 http://pms-server:9090）
PMS_SERVER_INTERNAL_URL=http://localhost:9090
# Agent 检查点/事件库（容器内 compose 覆盖 host 为 postgres:5432）
AGENT_DATABASE_URL=postgresql://pms:pms_local_dev@postgres:5432/pms_ai?options=-c%20search_path%3Dagent
# 允许跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_AGENT_BASE=http://localhost:8000
# 允许创建运行的商户白名单（逗号分隔）；本地演示固定为 demo-yunqi
AGENT_ALLOWED_MERCHANTS=demo-yunqi

# ========== 端口 ==========
WEB_PORT=3000

# ========== LLM ==========
# replay：回放模式，不调用真实模型
LLM_PROVIDER=replay
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
