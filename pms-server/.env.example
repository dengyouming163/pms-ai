# ========== 运行环境 ==========
# 本地开发用 development；生产由 docker-compose 的 pms-server 块设 NODE_ENV=production。
# 全局 onError 兜底仅在 NODE_ENV=development 时把 err.message 透给客户端，
# 其余情况（含未设）一律回通用文案，避免泄露 SQL / 参数。
NODE_ENV=development

# ========== 数据库 ==========
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=aipms
PG_USER=gate
PG_PASSWORD=your_password_here

# ========== 认证 ==========
# JWT 签名密钥（生产环境务必用随机64字符）
JWT_SECRET=change_me_to_random_64_chars
# 服务端口
PORT=9090
# 内部服务间调用 Token
INTERNAL_SERVICE_TOKEN=change_me_internal_token

# ========== Redis ==========
REDIS_URL=redis://localhost:6379

# ========== 依赖服务 ==========
AGENT_API_URL=http://localhost:8000

# ========== CORS ==========
CORS_ORIGINS=http://localhost:20001,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:8082

# ========== 私域小程序 pms-nimi（必需）==========
# C端 JWT 独立密钥（与员工 JWT_SECRET 必须不同，防止越权）
MINI_JWT_SECRET=change_mini_secret_2026
# 微信小程序 AppID（在 https://mp.weixin.qq.com 获取）
WX_MINI_APPID=wx0e5fc1f7fa23d1fe
# 微信小程序 AppSecret
WX_MINI_SECRET=your_mini_app_secret_here
# 微信订阅消息模板 id（入住前 24h 提醒；未配置时该提醒降级为站内消息）
# 模板字段需与 checkin-notify-scheduler.ts 的 buildTemplateData 一致
WX_SUBSCRIBE_TEMPLATE_ID=

# ========== 微信支付服务商 APIv3（可选）==========
WXPAY_SP_MCHID=
WXPAY_APIV3_KEY=
WXPAY_CERT_SERIAL=
# 商户私钥 PEM（换行用 \n 转义）
WXPAY_PRIVATE_KEY=
# 支付回调域名（HTTPS，微信平台要求）
WXPAY_NOTIFY_BASE=
# 平台支付子商户号（服务商模式；仅平台套餐/产品订单 H5 支付使用，房间订单仍按门店进件）
WXPAY_SUB_MCHID=
# 测试模式强制支付金额（分）：正整数=所有支付固定该分值；0/空=真实金额。联调完置空
WXPAY_TEST_AMOUNT_FEN=
# 微信支付公钥模式（2024+ 新商户）：回调验签必需
WXPAY_PUBLIC_KEY_ID=
# 微信支付公钥 PEM（换行用 \n 转义）
WXPAY_PUBLIC_KEY=
# 微信服务号（公众号）：H5 登录/支付（阶段2占位）
WX_MP_APPID=
WX_MP_SECRET=
# 公众号服务器配置 Token / EncodingAESKey（明文模式仅 Token 用于验签）
WX_MP_TOKEN=
WX_MP_AES_KEY=

# ========== 启动说明 ==========
# 本地开发: pnpm dev（自动加载本文件的环境变量，需要 Node.js >= 20）
# 生产部署: 通过 docker-compose.yml 或 systemd 注入环境变量
# 注意: WX_MINI_APPID 必须是真实的微信小程序 AppID，否则登录接口返回 502
